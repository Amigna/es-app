rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownEmail() {
      return request.auth.token.email.lower();
    }

    // Open to anyone signed in. Progress is keyed by uid, so a password account with an unverified email can only touch its own.
    function canSaveProgress() {
      return signedIn();
    }

    // Invites are now only for extras like `vulgar: true`, added by hand in the Firebase console. People can read their own,
    // once their email is verified, so nobody can claim someone else's invite with an unverified password account.
    match /invites/{email} {
      allow get: if signedIn() && request.auth.token.email_verified == true && ownEmail() == email;
      allow list, create, update, delete: if false;
    }

    // "Report a problem" from signed-in people. Read and clear them in the Firebase console.
    match /reports/{id} {
      allow create: if canSaveProgress()
        && request.resource.data.keys().hasOnly(['about', 'message', 'page', 'email', 'createdAt'])
        && request.resource.data.keys().hasAll(['about', 'message', 'page', 'email', 'createdAt'])
        && request.resource.data.about is string
        && request.resource.data.about.size() > 0
        && request.resource.data.about.size() <= 300
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 200
        && request.resource.data.email == ownEmail()
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Each person's data is private to them.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid && canSaveProgress();
    }
  }
}
